# Copy to .env for local `vercel dev`, and set the real values in the Vercel
# project's Settings -> Environment Variables for production. Never commit .env.

# The admin passcode, checked server-side only (never shipped to the browser).
# Pick a new one — do not reuse "saireddy2026", which is public in this project's history.
ADMIN_PASSCODE=change-me

# Random secret used to sign the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=change-me

# Vercel injects this automatically once a Blob store is attached to the project —
# you do not need to set it by hand in the dashboard. Leave unset for local dev
# (lib/store.js then falls back to a local .data/ directory instead of Blob storage).
# BLOB_READ_WRITE_TOKEN=
